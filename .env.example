# =============================================================================
# GreenOps AI - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the REQUIRED values. Never commit .env.
# Keep secret values empty in this template.
#
# Required local setup:
#   cp .env.example .env
#   # then edit .env and set ELECTRICITY_MAPS_API_KEY and GRAFANA_ADMIN_PASSWORD
# =============================================================================

# Application
APP_ENV=development                    # [optional] development | staging | production
LOG_LEVEL=INFO                         # [optional] DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                        # [optional] json | pretty

# Electricity Maps API
ELECTRICITY_MAPS_API_KEY=              # [REQUIRED] set a real key only in local .env
ELECTRICITY_MAPS_BASE_URL=https://api.electricitymap.org/v3
ELECTRICITY_MAPS_ZONE=DE
ELECTRICITY_MAPS_CACHE_TTL_SECONDS=300

# Kubernetes telemetry scope
K8S_NAMESPACE=greenops-dev

# Prometheus
PROMETHEUS_API_URL=http://localhost:9090
PROMETHEUS_METRICS_EXPORT_PORT=8000

# AI Agent safety bounds
AGENT_POLL_INTERVAL_SECONDS=60
AGENT_MIN_REPLICAS=1
AGENT_MAX_REPLICAS=10
AGENT_CPU_SAFETY_THRESHOLD=0.70
AGENT_LATENCY_SLA_THRESHOLD_SECONDS=1.0
AGENT_MAX_SCALE_DOWN_PERCENTAGE=0.50
AGENT_OPTIMIZATION_COOLDOWN_SECONDS=900
AGENT_MAX_CARBON_DATA_AGE_SECONDS=5400

# GitOps
GREENOPS_GITOPS_REPO_PATH=.
GREENOPS_GITOPS_BASE_BRANCH=main
GREENOPS_GITOPS_BRANCH_PREFIX=greenops
GREENOPS_GITOPS_MANIFEST_PATH=k8s/overlays/prod/kustomization.yaml
GREENOPS_GITOPS_DEPLOYMENT_NAME=greenops-demo-workload
GREENOPS_GITOPS_CREATE_PULL_REQUEST=false
GREENOPS_GITOPS_GITHUB_REPOSITORY= set_your_own
GREENOPS_GITOPS_GITHUB_TOKEN=  set_your_own

# Reporting
REPORT_OUTPUT_DIR=./reports/output
REPORT_DECISION_HISTORY_PATH=./reports/decision-history.jsonl

# Grafana (docker-compose only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD= set_your_own
