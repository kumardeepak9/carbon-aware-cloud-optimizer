# =============================================================================
# Carbon-Aware Cloud Optimizer — Environment Variables
# =============================================================================
# Copy to .env and fill in the REQUIRED values. NEVER commit .env.
#
#   [REQUIRED]  the process fails to start without this
#   [optional]  has a safe default; override only if you need to
#
# Startup validation (config/settings.py):
#   - a REQUIRED variable that is missing or a placeholder -> ValidationError
#   - APP_ENV=production with a dev-only value (pretty logs, a loopback
#     Prometheus URL, a placeholder GitHub token) -> ConfigurationError
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                    # [optional] development | staging | production
LOG_LEVEL=INFO                         # [optional] DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                        # [optional] json (prod) | pretty (local). Must be json when APP_ENV=production.

# ---------------------------------------------------------------------------
# Electricity Maps API  (https://api.electricitymap.org)
#   Consumed by the carbon exporter (carbon/server.py). The read-only agent
#   does NOT need this — it reads carbon data from Prometheus.
# ---------------------------------------------------------------------------
ELECTRICITY_MAPS_API_KEY=             # [REQUIRED for the carbon exporter] a real Electricity Maps key
ELECTRICITY_MAPS_BASE_URL=https://api.electricitymap.org/v3   # [optional] must be https://
ELECTRICITY_MAPS_ZONE=DE              # [optional] ISO 3166-1 alpha-2 or Electricity Maps zone ID
ELECTRICITY_MAPS_CACHE_TTL_SECONDS=300 # [optional] >= 30

# ---------------------------------------------------------------------------
# Kubernetes
#   GreenOps has no Kubernetes API client (Git -> Argo CD is the only write
#   path), so there is no kubeconfig setting. This only scopes Prometheus queries.
# ---------------------------------------------------------------------------
K8S_NAMESPACE=greenops               # [optional] workload namespace observed via Prometheus

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------
PROMETHEUS_API_URL=http://localhost:9090   # [optional in dev / REQUIRED real value in production]
PROMETHEUS_METRICS_EXPORT_PORT=8000        # [optional] 1024-65535; carbon exporter serves on this + 2

# ---------------------------------------------------------------------------
# AI Agent  (safety bounds — see agent/safety.py)
# ---------------------------------------------------------------------------
AGENT_POLL_INTERVAL_SECONDS=60        # [optional] >= 10; carbon-exporter fetch cadence
AGENT_MIN_REPLICAS=1                  # [optional] >= 0, and <= AGENT_MAX_REPLICAS
AGENT_MAX_REPLICAS=10                 # [optional] >= 1
AGENT_CPU_SAFETY_THRESHOLD=0.70       # [optional] 0.0-1.0
AGENT_LATENCY_SLA_THRESHOLD_SECONDS=1.0   # [optional] > 0
AGENT_MAX_SCALE_DOWN_PERCENTAGE=0.50  # [optional] > 0.0, <= 1.0
AGENT_OPTIMIZATION_COOLDOWN_SECONDS=900   # [optional] >= 0
AGENT_MAX_CARBON_DATA_AGE_SECONDS=600     # [optional] >= 0

# ---------------------------------------------------------------------------
# GitOps  (review-first GitHub PR preparation — see gitops/)
# ---------------------------------------------------------------------------
GREENOPS_GITOPS_REPO_PATH=.                                   # [optional] local desired-state checkout
GREENOPS_GITOPS_BASE_BRANCH=main                              # [optional] simple branch name
GREENOPS_GITOPS_BRANCH_PREFIX=greenops                        # [optional] simple branch prefix
GREENOPS_GITOPS_MANIFEST_PATH=k8s/overlays/prod/kustomization.yaml  # [optional] must be under k8s/, no '..'
GREENOPS_GITOPS_DEPLOYMENT_NAME=greenops-demo-workload        # [optional]
GREENOPS_GITOPS_CREATE_PULL_REQUEST=false                     # [optional] true => the next two become REQUIRED
GREENOPS_GITOPS_GITHUB_REPOSITORY=                            # [REQUIRED if CREATE_PULL_REQUEST=true] owner/name
GREENOPS_GITOPS_GITHUB_TOKEN=                                 # [REQUIRED if CREATE_PULL_REQUEST=true] a real PAT (write:contents)
# GREENOPS_GITOPS_GITHUB_API_URL=https://api.github.com       # [optional] must be https://, no embedded credentials

# ---------------------------------------------------------------------------
# Reporting  (python -m reports.report)
# ---------------------------------------------------------------------------
REPORT_OUTPUT_DIR=./reports/output                            # [optional]
REPORT_DECISION_HISTORY_PATH=./reports/decision-history.jsonl # [optional] append-only log the chat interface reads

# ---------------------------------------------------------------------------
# Grafana  (docker-compose only — not read by the Python app)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin                                      # [optional]
GRAFANA_ADMIN_PASSWORD=                                       # [REQUIRED to start the Grafana container] no default
