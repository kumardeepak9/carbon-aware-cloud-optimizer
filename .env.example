# =============================================================================
# Carbon-Aware Cloud Optimizer — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                        # json | pretty

# ---------------------------------------------------------------------------
# Electricity Maps API  (https://api.electricitymap.org)
# ---------------------------------------------------------------------------
ELECTRICITY_MAPS_API_KEY=your-api-key-here
ELECTRICITY_MAPS_BASE_URL=https://api.electricitymap.org/v3
ELECTRICITY_MAPS_ZONE=DE              # ISO 3166-1 alpha-2 or zone code
ELECTRICITY_MAPS_CACHE_TTL_SECONDS=300 # How long to cache grid data

# ---------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------
K8S_IN_CLUSTER=false                  # true when running inside a pod
K8S_KUBECONFIG_PATH=~/.kube/config    # ignored when K8S_IN_CLUSTER=true
K8S_NAMESPACE=greenops                # Default target namespace

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------
PROMETHEUS_API_URL=http://localhost:9090
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091
PROMETHEUS_METRICS_EXPORT_PORT=8000   # Port for the pull-based metrics server

# ---------------------------------------------------------------------------
# AI Agent
# ---------------------------------------------------------------------------
AGENT_POLL_INTERVAL_SECONDS=60        # How often the agent checks carbon intensity
AGENT_CARBON_INTENSITY_THRESHOLD_HIGH=250 # gCO2eq/kWh — trigger scale-down
AGENT_CARBON_INTENSITY_THRESHOLD_LOW=100  # gCO2eq/kWh — allow scale-up
AGENT_MIN_REPLICAS=1
AGENT_MAX_REPLICAS=10
AGENT_CPU_SAFETY_THRESHOLD=0.70
AGENT_LATENCY_SLA_THRESHOLD_SECONDS=1.0
AGENT_MAX_SCALE_DOWN_PERCENTAGE=0.50
AGENT_OPTIMIZATION_COOLDOWN_SECONDS=900
AGENT_MAX_CARBON_DATA_AGE_SECONDS=600

# ---------------------------------------------------------------------------
# GitOps
# ---------------------------------------------------------------------------
GREENOPS_GITOPS_REPO_PATH=.
GREENOPS_GITOPS_BASE_BRANCH=main
GREENOPS_GITOPS_BRANCH_PREFIX=greenops
GREENOPS_GITOPS_MANIFEST_PATH=k8s/overlays/prod/kustomization.yaml
GREENOPS_GITOPS_DEPLOYMENT_NAME=greenops-demo-workload
GREENOPS_GITOPS_GITHUB_REPOSITORY=your-org/carbon-aware-cloud-optimizer
GREENOPS_GITOPS_GITHUB_TOKEN=your-github-token-here
GREENOPS_GITOPS_CREATE_PULL_REQUEST=false

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
REPORT_SCHEDULE_CRON=0 8 * * MON      # Weekly report trigger (Monday 08:00)
REPORT_OUTPUT_DIR=./reports/output
REPORT_RECIPIENTS=team@example.com    # Comma-separated list

REPORT_SMTP_HOST=smtp.example.com
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=notifications@example.com
REPORT_SMTP_PASSWORD=your-smtp-password-here
REPORT_SMTP_USE_TLS=true
