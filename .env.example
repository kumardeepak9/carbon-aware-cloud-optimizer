# =============================================================================
# Carbon-Aware Cloud Optimizer — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                        # json | pretty

# ---------------------------------------------------------------------------
# Electricity Maps API  (https://api.electricitymap.org)
# ---------------------------------------------------------------------------
ELECTRICITY_MAPS_API_KEY=your-api-key-here
ELECTRICITY_MAPS_BASE_URL=https://api.electricitymap.org/v3
ELECTRICITY_MAPS_ZONE=DE              # ISO 3166-1 alpha-2 or zone code
CARBON_CACHE_TTL_SECONDS=300          # How long to cache grid data

# ---------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------
K8S_IN_CLUSTER=false                  # true when running inside a pod
KUBECONFIG_PATH=~/.kube/config        # ignored when K8S_IN_CLUSTER=true
K8S_NAMESPACE=greenops                # Default target namespace

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091
METRICS_EXPORT_PORT=8000              # Port for the pull-based metrics server

# ---------------------------------------------------------------------------
# AI Agent
# ---------------------------------------------------------------------------
AGENT_POLL_INTERVAL_SECONDS=60        # How often the agent checks carbon intensity
CARBON_INTENSITY_THRESHOLD_HIGH=250   # gCO2eq/kWh — trigger scale-down
CARBON_INTENSITY_THRESHOLD_LOW=100    # gCO2eq/kWh — allow scale-up

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
REPORT_SCHEDULE_CRON=0 8 * * MON      # Weekly report trigger (Monday 08:00)
REPORT_OUTPUT_DIR=./reports/output
REPORT_RECIPIENTS=team@example.com    # Comma-separated list

# ---------------------------------------------------------------------------
# SMTP (for email reports — optional)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_USE_TLS=true
